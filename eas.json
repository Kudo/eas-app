{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 5.2.0"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "withoutCredentials": true
    }
  },
  "submit": {
    "production": {}
  }
}
